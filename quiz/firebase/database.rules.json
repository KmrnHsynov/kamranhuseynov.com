{
  "rules": {
    "exam_index": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$exam": {
        ".validate": "newData.hasChildren(['topic', 'examMinutes', 'leaveLimit', 'publishedAt', 'qCount'])",
        "topic":       { ".validate": "newData.isString() && newData.val().length <= 200" },
        "examMinutes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000" },
        "leaveLimit":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
        "publishedAt": { ".validate": "newData.isNumber()" },
        "qCount":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "opensAt":     { ".validate": "newData.isNumber()" },
        "closesAt":    { ".validate": "newData.isNumber()" },
        "active":      { ".validate": "newData.isBoolean()" },
        "oneAttempt":  { ".validate": "newData.isBoolean()" },
        "$other":      { ".validate": false }
      }
    },
    "student_quiz": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$exam": {
        ".read": "(!data.child('active').exists() || data.child('active').val() !== false) && (!data.child('opensAt').exists() || now >= data.child('opensAt').val())",
        "opensAt":  { ".validate": "newData.isNumber()" },
        "closesAt": { ".validate": "newData.isNumber()" },
        "active":   { ".validate": "newData.isBoolean()" },
        "oneAttempt": { ".validate": "newData.isBoolean()" },
        "payload":  { ".validate": "newData.isString() && newData.val().length < 2000000" },
        "questions": {
          "$i": {
            "correctOption": { ".validate": false },
            "tfAnswer":      { ".validate": false },
            "shortAnswer":   { ".validate": false },
            "fillAnswers":   { ".validate": false }
          }
        }
      }
    },
    "results": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$id": {
        ".read": true,
        ".validate": "newData.hasChildren(['exam', 'topic', 'studentName', 'correct', 'wrong', 'unanswered', 'score', 'maxScore', 'pct', 'releasedAt'])",
        "exam":        { ".validate": "newData.isString() && newData.val().length <= 200" },
        "topic":       { ".validate": "newData.isString() && newData.val().length <= 200" },
        "studentName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "correct":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "wrong":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "unanswered":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "score":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "maxScore":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "pct":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "releasedAt":  { ".validate": "newData.isNumber()" },
        "$other":      { ".validate": false }
      }
    },
    "answer_keys": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'"
    },
    "analytics": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$exam": {
        "$attempt": {
          ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || (data.child('uid').val() === auth.uid && data.child('status').val() === 'in_progress'))",
          ".validate": "newData.hasChildren(['attemptId', 'uid', 'status', 'studentName', 'topic', 'examVersion', 'startedAt', 'updatedAt', 'qids', 'tabSwitches', 'timeAway', 'pastes', 'autoSubmitted']) && (newData.child('status').val() === 'in_progress') === !newData.child('finishedAt').exists() && (data.exists() || ((!root.child('student_quiz').child($exam).child('opensAt').exists() || now >= root.child('student_quiz').child($exam).child('opensAt').val()) && (!root.child('student_quiz').child($exam).child('closesAt').exists() || now <= root.child('student_quiz').child($exam).child('closesAt').val()))) && (!root.child('student_quiz').child($exam).child('examMinutes').exists() || now <= newData.child('startedAt').val() + root.child('student_quiz').child($exam).child('examMinutes').val() * 60000 + 120000)",
          "attemptId":     { ".validate": "newData.isString() && newData.val() === $attempt" },
          "uid":           { ".validate": "newData.val() === auth.uid" },
          "status":        { ".validate": "newData.isString() && (newData.val() === 'in_progress' || newData.val() === 'done' || newData.val() === 'exited')" },
          "studentName":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "topic":         { ".validate": "newData.isString() && newData.val().length <= 200" },
          "examVersion":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,16}$/)" },
          "startedAt":     { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
          "updatedAt":     { ".validate": "newData.isNumber() && newData.val() === now" },
          "finishedAt":    { ".validate": "newData.isNumber() && newData.val() === now" },
          "qids": {
            "$i": { ".validate": "$i.matches(/^([0-9]|[12][0-9])$/) && newData.isString() && root.child('answer_keys').child($exam).child(newData.parent().parent().child('examVersion').val()).child('questions').child(newData.val()).exists()" }
          },
          "answers": {
            "$qid": {
              ".validate": "root.child('answer_keys').child($exam).child(newData.parent().parent().child('examVersion').val()).child('questions').child($qid).exists() && ((newData.isNumber() && newData.val() >= 0 && newData.val() <= 4) || newData.isBoolean() || (newData.isString() && newData.val().length <= 500) || newData.hasChildren())",
              "$k": { ".validate": "$k.matches(/^([0-9]|[1-9][0-9])$/) && newData.isString() && newData.val().length <= 200" }
            }
          },
          "tabSwitches":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "timeAway":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
          "pastes":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "autoSubmitted": { ".validate": "newData.isBoolean()" },
          "autoReason":    { ".validate": "newData.isString() && newData.val() === 'leaves'" },
          "events": {
            "$i": {
              ".validate": "$i.matches(/^([0-9]|[1-9][0-9])$/) && newData.hasChildren(['type', 't'])",
              "type": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "t":    { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "live_rooms": {
      "$pin": {
        ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",

        "meta": {
          ".read": true,
          ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
          ".validate": "newData.hasChildren(['topic', 'status', 'currentIndex', 'questionCount', 'questionSeconds', 'leaveLimit', 'createdAt'])",
          "topic":            { ".validate": "newData.isString() && newData.val().length <= 200" },
          "status":           { ".validate": "newData.isString() && (newData.val() === 'LOBBY' || newData.val() === 'QUESTION' || newData.val() === 'REVEAL' || newData.val() === 'FINISHED')" },
          "currentIndex":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
          "questionCount":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30" },
          "questionSeconds":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 300" },
          "questionStartedAt":{ ".validate": "newData.isNumber()" },
          "leaveLimit":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
          "createdAt":        { ".validate": "newData.isNumber()" },
          "$other":           { ".validate": false }
        },

        "questions": {
          ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
          "$i": {
            ".read": "auth != null && (auth.token.email === 'kmrnhsynov@gmail.com' || (root.child('live_rooms').child($pin).child('meta').child('status').val() !== 'LOBBY' && (root.child('live_rooms').child($pin).child('meta').child('currentIndex').val() + '') === $i) || root.child('live_rooms').child($pin).child('meta').child('status').val() === 'FINISHED')"
          }
        },

        "answer_key": {
          ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
          ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'"
        },

        "players": {
          ".read": true,
          "$uid": {
            "profile": {
              ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'kmrnhsynov@gmail.com')",
              ".validate": "newData.hasChildren(['displayName', 'joinedAt'])",
              "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
              "joinedAt":    { ".validate": "newData.isNumber()" },
              "connected":   { ".validate": "newData.isBoolean()" },
              "$other":      { ".validate": false }
            },
            "score": {
              ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "flags": {
              ".write": "auth != null && auth.uid === $uid",
              "tabSwitches": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
              "timeAway":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
              "pastes":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
              "flagged":     { ".validate": "newData.isBoolean()" },
              "$other":      { ".validate": false }
            }
          }
        },

        "answers": {
          ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
          "$i": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('live_rooms').child($pin).child('meta').child('status').val() === 'QUESTION' && (root.child('live_rooms').child($pin).child('meta').child('currentIndex').val() + '') === $i && now <= root.child('live_rooms').child($pin).child('meta').child('questionStartedAt').val() + root.child('live_rooms').child($pin).child('meta').child('questionSeconds').val() * 1000 + 15000",
              ".validate": "newData.hasChildren(['responseTimeMs', 'submittedAt'])",
              "responseTimeMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600000" },
              "submittedAt":    { ".validate": "newData.isNumber() && newData.val() === now" },
              "selectedOption": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4" },
              "tfAnswer":       { ".validate": "newData.isBoolean()" },
              "shortAnswer":    { ".validate": "newData.isString() && newData.val().length <= 500" },
              "fillAnswers":    { "$k": { ".validate": "newData.isString() && newData.val().length <= 200" } },
              "$other":         { ".validate": false }
            }
          }
        },

        "results": {
          ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
          "$i": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'kmrnhsynov@gmail.com')"
            }
          }
        },

        "rejoin_requests": {
          ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['targetUid', 'requestedAt'])",
            "targetUid":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
            "requestedAt": { ".validate": "newData.isNumber()" },
            "$other":      { ".validate": false }
          }
        }
      }
    },

    "live_history": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$id": {
        ".validate": "newData.hasChildren(['topic', 'createdAt', 'finishedAt', 'questionCount', 'playerCount', 'leaderboard'])",
        "topic":         { ".validate": "newData.isString() && newData.val().length <= 200" },
        "createdAt":     { ".validate": "newData.isNumber()" },
        "finishedAt":    { ".validate": "newData.isNumber()" },
        "questionCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30" },
        "playerCount":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "leaderboard": {
          "$i": {
            "name":   { ".validate": "newData.isString() && newData.val().length <= 60" },
            "score":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
