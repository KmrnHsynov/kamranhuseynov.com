{
  "rules": {
    "student_quiz": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$exam": {
        "opensAt":  { ".validate": "newData.isNumber()" },
        "closesAt": { ".validate": "newData.isNumber()" },
        "questions": {
          "$i": {
            "correctOption": { ".validate": false },
            "tfAnswer":      { ".validate": false },
            "shortAnswer":   { ".validate": false },
            "fillAnswers":   { ".validate": false }
          }
        }
      }
    },
    "results": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$id": {
        ".read": true,
        ".validate": "newData.hasChildren(['exam', 'topic', 'studentName', 'correct', 'wrong', 'unanswered', 'score', 'maxScore', 'pct', 'releasedAt'])",
        "exam":        { ".validate": "newData.isString() && newData.val().length <= 200" },
        "topic":       { ".validate": "newData.isString() && newData.val().length <= 200" },
        "studentName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "correct":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "wrong":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "unanswered":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "score":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "maxScore":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
        "pct":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "releasedAt":  { ".validate": "newData.isNumber()" },
        "$other":      { ".validate": false }
      }
    },
    "answer_keys": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'"
    },
    "analytics": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$exam": {
        "$attempt": {
          ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || (data.child('uid').val() === auth.uid && data.child('status').val() === 'in_progress'))",
          ".validate": "newData.hasChildren(['attemptId', 'uid', 'status', 'studentName', 'topic', 'examVersion', 'startedAt', 'updatedAt', 'qids', 'tabSwitches', 'timeAway', 'pastes', 'autoSubmitted']) && (newData.child('status').val() === 'in_progress') === !newData.child('finishedAt').exists() && (data.exists() || ((!root.child('student_quiz').child($exam).child('opensAt').exists() || now >= root.child('student_quiz').child($exam).child('opensAt').val()) && (!root.child('student_quiz').child($exam).child('closesAt').exists() || now <= root.child('student_quiz').child($exam).child('closesAt').val()))) && (!root.child('student_quiz').child($exam).child('examMinutes').exists() || now <= newData.child('startedAt').val() + root.child('student_quiz').child($exam).child('examMinutes').val() * 60000 + 120000)",
          "attemptId":     { ".validate": "newData.isString() && newData.val() === $attempt" },
          "uid":           { ".validate": "newData.val() === auth.uid" },
          "status":        { ".validate": "newData.isString() && (newData.val() === 'in_progress' || newData.val() === 'done' || newData.val() === 'exited')" },
          "studentName":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "topic":         { ".validate": "newData.isString() && newData.val().length <= 200" },
          "examVersion":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,16}$/)" },
          "startedAt":     { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
          "updatedAt":     { ".validate": "newData.isNumber() && newData.val() === now" },
          "finishedAt":    { ".validate": "newData.isNumber() && newData.val() === now" },
          "qids": {
            "$i": { ".validate": "$i.matches(/^([0-9]|[12][0-9])$/) && newData.isString() && root.child('answer_keys').child($exam).child(newData.parent().parent().child('examVersion').val()).child('questions').child(newData.val()).exists()" }
          },
          "answers": {
            "$qid": {
              ".validate": "root.child('answer_keys').child($exam).child(newData.parent().parent().child('examVersion').val()).child('questions').child($qid).exists() && ((newData.isNumber() && newData.val() >= 0 && newData.val() <= 4) || newData.isBoolean() || (newData.isString() && newData.val().length <= 500) || newData.hasChildren())",
              "$k": { ".validate": "$k.matches(/^([0-9]|[1-9][0-9])$/) && newData.isString() && newData.val().length <= 200" }
            }
          },
          "tabSwitches":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "timeAway":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
          "pastes":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "autoSubmitted": { ".validate": "newData.isBoolean()" },
          "autoReason":    { ".validate": "newData.isString() && newData.val() === 'leaves'" },
          "events": {
            "$i": {
              ".validate": "$i.matches(/^([0-9]|[1-9][0-9])$/) && newData.hasChildren(['type', 't'])",
              "type": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "t":    { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
