{
  "rules": {
    "student_quiz": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'"
    },
    "analytics": {
      ".read": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      ".write": "auth != null && auth.token.email === 'kmrnhsynov@gmail.com'",
      "$exam": {
        "$attempt": {
          ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || (data.child('uid').val() === auth.uid && data.child('status').val() === 'in_progress'))",
          ".validate": "newData.hasChildren(['attemptId', 'uid', 'status', 'studentName', 'topic', 'timestamp', 'totalQuestions', 'correct', 'wrong', 'unanswered', 'score', 'maxScore', 'pct', 'timeUsed', 'tabSwitches', 'timeAway', 'pastes', 'autoSubmitted'])",
          "attemptId":      { ".validate": "newData.isString() && newData.val() === $attempt" },
          "uid":            { ".validate": "newData.isString()" },
          "status":         { ".validate": "newData.isString() && (newData.val() === 'in_progress' || newData.val() === 'done' || newData.val() === 'exited')" },
          "studentName":    { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          "topic":          { ".validate": "newData.isString() && newData.val().length <= 200" },
          "timestamp":      { ".validate": "newData.isNumber()" },
          "totalQuestions": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "correct":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "wrong":          { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "unanswered":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "score":          { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "maxScore":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "pct":            { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "timeUsed":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
          "tabSwitches":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "timeAway":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
          "pastes":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "autoSubmitted":  { ".validate": "newData.isBoolean()" },
          "autoReason":     { ".validate": "newData.isString() && newData.val() === 'leaves'" },
          "events": {
            "$i": {
              ".validate": "$i.matches(/^([0-9]|[1-9][0-9])$/) && newData.hasChildren(['type', 't'])",
              "type": { ".validate": "newData.isString() && newData.val().length <= 10" },
              "t":    { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
